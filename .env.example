# Copiez ce fichier en .env et renseignez les valeurs. Ne versionnez jamais .env.

# --- Base de données (PostgreSQL, voir docker-compose.yml) ---
DATABASE_URL="postgresql://twin:twin_local_password@localhost:5432/twin"
# Base dédiée aux tests d'intégration (doit contenir « test » dans son nom).
TEST_DATABASE_URL="postgresql://twin:twin_local_password@localhost:5432/twin_test"

# --- URL publique de l'application (retour après déconnexion Auth0, contrôle du mode test) ---
NUXT_SITE_URL="http://localhost:3000"

# --- Session chiffrée (au moins 32 caractères aléatoires) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=""

# --- Chiffrement des contenus personnels au repos (32 octets en base64) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Attention : perdre ou changer cette clé rend les contenus existants illisibles.
NUXT_DATA_ENCRYPTION_KEY=""

# --- Auth0 (application de type « Regular Web Application ») ---
# Allowed Callback URLs : http://localhost:3000/auth/auth0
# Allowed Logout URLs   : http://localhost:3000
NUXT_OAUTH_AUTH0_DOMAIN=""
NUXT_OAUTH_AUTH0_CLIENT_ID=""
NUXT_OAUTH_AUTH0_CLIENT_SECRET=""
# Facultatif si l'URL de rappel ne peut pas être déduite (proxy) :
NUXT_OAUTH_AUTH0_REDIRECT_URL=""

# --- IA conversationnelle (Anthropic) ---
NUXT_ANTHROPIC_API_KEY=""
# Modèle utilisé tel quel : aucun repli automatique vers un autre modèle ni vers une IA simulée.
NUXT_ANTHROPIC_MODEL="claude-sonnet-5-5"
# Plafond de tokens générés par réponse (raisonnement inclus).
NUXT_ANTHROPIC_MAX_OUTPUT_TOKENS="2000"

# --- Maîtrise des coûts (garde-fous applicatifs, pas des plafonds de facturation) ---
NUXT_AI_RATE_LIMIT_PER_MINUTE="6"
NUXT_AI_RATE_LIMIT_PER_DAY="100"
# Plafond cumulé estimé en dollars US : au-delà, plus aucun appel n'est envoyé au fournisseur.
NUXT_AI_BUDGET_USD="12"
# Tarifs en $ par million de tokens (Claude Sonnet 5.5) servant à l'estimation.
NUXT_AI_PRICE_INPUT_PER_MTOK="2"
NUXT_AI_PRICE_OUTPUT_PER_MTOK="10"
NUXT_AI_PRICE_CACHE_READ_PER_MTOK="0.2"
NUXT_AI_PRICE_CACHE_WRITE_PER_MTOK="2.5"

# --- Accès ---
# Nombre maximal de comptes pouvant être créés (vide = illimité ; 1 = seulement le premier compte).
NUXT_REGISTRATION_LIMIT=""
# Durée de la session en secondes (défaut : 8 h).
NUXT_SESSION_MAX_AGE=""

# --- Mode test local (comptes fictifs + modèle simulé). Jamais en dehors de localhost. ---
NUXT_PUBLIC_TEST_MODE="false"
