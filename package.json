{
  "name": "jumeau-emotionnel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "nuxt build && playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@primevue/core": "4.5.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^18.0.8",
    "nuxt": "4.6.1",
    "nuxt-auth-utils": "0.5.31",
    "ofetch": "^1.5.1",
    "pg": "^8.16.0",
    "primeicons": "^7.0.0",
    "primevue": "4.5.5",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "eslint": "^10.12.0",
    "prisma": "7.10.0",
    "sass": "1.105.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.13"
  }
}
